# herdr-clip-recv -- take a base64 PNG on stdin, save it, print where it went.
# That is the whole job. The other half is
# home-manager/dotfiles/windows/pwsh/ps1.d/herdr-clip.ps1.
#
# The name still says herdr because that is where this came from, but nothing
# here needs Herdr any more, and that is the point of the current shape. It used
# to end with `herdr pane send-text <pane> "<path> "`, which meant guessing WHICH
# pane -- and guessing wrong: the server's single focused pane belongs to
# whichever client last had focus, which on a machine running two Herdr sessions
# was a pane the user was not looking at. Herdr's own skill file says it: "Do not
# rely on another client's focused pane."
#
# The typing now happens on the Windows side, into whatever window is focused
# there -- which is by definition the terminal the user is looking at. So the
# question "which pane" no longer exists, and this script no longer needs the
# herdr binary, jq, or a Herdr server at all. It works the same into tmux, a
# plain ssh shell, an editor, or nothing at all.
#
# Why base64 on stdin rather than scp:
#   - One connection. Windows OpenSSH has no ControlMaster, so a second ssh call
#     pays another full handshake over Tailscale.
#   - PowerShell re-encodes binary through a native-command pipe (it converts to
#     text via $OutputEncoding), which corrupts PNG bytes. Base64 is ASCII and
#     comes through untouched.
#
# OUTPUT CONTRACT: the absolute path, alone, on the last line of stdout. The
# sender matches lines ending in .png and takes the last one.
#
# No shebang on purpose -- writeShellApplication supplies one and adds
# `set -euo pipefail`. Run it as `bash herdr-clip-recv` to test before a rebuild.

case "${1:-}" in
    -h | --help)
        cat <<'EOF'
usage: herdr-clip-recv < base64-encoded-png

Saves the image under ${XDG_CACHE_HOME:-$HOME/.cache}/herdr-clip and prints its
absolute path. Sent from Windows by Send-ClipImage (Tab+v), which then types the
path into the focused window there.
EOF
        exit 0
        ;;
    '') ;;
    *)
        echo "herdr-clip-recv: unknown argument: $1" >&2
        exit 2
        ;;
esac

dir="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-clip"
mkdir -p "$dir"

# $$ disambiguates two screenshots that land inside the same second.
out="$dir/$(date +%Y%m%d-%H%M%S)-$$.png"

if ! base64 -d >"$out"; then
    rm -f "$out"
    echo "herdr-clip-recv: stdin was not valid base64" >&2
    exit 1
fi

# A truncated transfer still leaves a file behind, and an agent failing to read a
# half-written PNG reads as the agent's bug. Check the signature here instead.
magic=$(head -c 8 "$out" | od -An -tx1 | tr -d ' \n')
if [ "$magic" != "89504e470d0a1a0a" ]; then
    rm -f "$out"
    echo "herdr-clip-recv: decoded data is not a PNG" >&2
    exit 1
fi

# A week outlives any screenshot's usefulness, and every file here is a copy of
# something the sending machine had first.
find "$dir" -name '*.png' -type f -mtime +7 -delete 2>/dev/null || true

echo "$out"
