#!/usr/bin/env bash
#
# ime-route -- lai bo go o MAY NAO DANG GIU BAN PHIM, khong phai may nao chay nvim.
#
# Voi `herdr --remote macmini`, nvim chay tren macmini con ban phim o rog: fcitx5
# tren rog bien phim thanh tieng Viet TRUOC khi byte di qua SSH. tongue.nvim chi
# lai duoc bo go cua may no dang chay, nen khong co script nay no doi input source
# cua macmini -- dung y thiet ke, sai may. Do 19/08/2026: nvim tren macmini nhay
# vi->en->vi du thu, rog dung im o keyboard-us suot.
#
# Script nay la mot backend cua tongue.nvim (hop dong 4 khoa), khong phai mot lop
# va vong: no chuan hoa hai the gioi ve chung mot bang tu vung en/vi/zh roi dinh
# tuyen sang dung may.
#
#   ime-route get           -> in en | vi | zh | unknown
#   ime-route set <token>   -> dat che do do
#   ime-route where         -> in dich dang dung (de go roi / checkhealth)
#
# Ban phim o dau: tien trinh `herdr remote-client-bridge` chi ton tai khi co
# client tu xa dang attach, va SSH_CONNECTION cua CHINH NO ghi IP client HIEN TAI.
# Dung nham SSH_CONNECTION thua ke trong pane la sai: bien do la hoa thach cua
# luc herdr server khoi dong, con nguyen ca khi nguoi dung ngoi ngay truoc may.

set -uo pipefail

# Ten input method phia fcitx5. Group cua rog dung co hai muc nay; may khac thi
# ghi de bang bien moi truong thay vi sua file.
EN_IM=${IME_ROUTE_EN_IM:-keyboard-us}
VI_IM=${IME_ROUTE_VI_IM:-lotus}

# IP cua client dang attach, hoac that bai neu ban phim o ngay may nay.
client_ip() {
  local pid
  pid=$(ps -eo pid,args | awk '/[r]emote-client-bridge/ { print $1; exit }')
  [ -n "$pid" ] || return 1
  # `ps -E` in ca environ sau argv. SSH_CONNECTION la
  # "<client-ip> <client-port> <server-ip> <server-port>", nen tach theo khoang
  # trang thi truong ngay sau dau `=` chinh la IP client.
  ps -E -p "$pid" -o command= 2>/dev/null |
    tr ' ' '\n' |
    awk -F= '$1 == "SSH_CONNECTION" { print $2; exit }'
}

# Ten Host trong ~/.ssh/config co HostName trung IP nay. Doc lai tu do thay vi
# giu mot bang IP rieng o day -- ssh config da la nguon chan ly cho viec nay.
ssh_host_for() {
  awk -v ip="$1" '
    tolower($1) == "host"                                  { host = $2 }
    tolower($1) == "hostname" && $2 == ip && host != ""    { print host; exit }
  ' ~/.ssh/config
}

# Rong = lai bo go cua chinh may nay bang `tongue`.
target=""
if ip=$(client_ip) && [ -n "$ip" ]; then
  target=$(ssh_host_for "$ip")
fi

remote() { # $@ = tham so cho fcitx5-remote o dau kia
  ssh -o BatchMode=yes -o ConnectTimeout=3 "$target" \
    'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus fcitx5-remote '"$*"
}

case "${1:-}" in
get)
  if [ -n "$target" ]; then
    im=$(remote -n) || exit 1
    case "$im" in
    # `-n` can mot input context dang focus; khong co thi no in RONG va van
    # thoat 0. Tra `unknown` thay vi de rong: rong bi sanitize loai voi ly do
    # "empty output", con `unknown` la tin hieu co nghia trong hop dong.
    "") echo unknown ;;
    "$EN_IM") echo en ;;
    # Group cua rog chi co hai muc, nen "khong phai tieng Anh" = bo go tieng
    # Viet dang bat. May nao co nhieu hon thi dat IME_ROUTE_VI_IM cho dung.
    *) echo vi ;;
    esac
  else
    # Y het preset `tongue` cua tongue.nvim: goi tran de doc, tham so de dat.
    tongue
  fi
  ;;

set)
  mode=${2:-}
  [ -n "$mode" ] || {
    echo "ime-route: set can mot token (en|vi|zh)" >&2
    exit 2
  }
  if [ -n "$target" ]; then
    case "$mode" in
    en) remote -s "$EN_IM" >/dev/null ;;
    vi) remote -s "$VI_IM" >/dev/null ;;
    # zh khong ton tai phia fcitx5. Chi toi duoc day khi nguoi dung tung o che
    # do zh luc ngoi truoc macmini roi attach tu xa; bao that bai de plugin
    # kiem chung lai bang mot lan doc thay vi im lang khong lam gi.
    *)
      echo "ime-route: '$mode' khong co o $target" >&2
      exit 3
      ;;
    esac
  else
    tongue "$mode" >/dev/null
  fi
  ;;

where)
  if [ -n "$target" ]; then
    echo "remote: $target (ban phim o do)"
  else
    echo "local: tongue"
  fi
  ;;

*)
  echo "usage: ime-route get | set <en|vi|zh> | where" >&2
  exit 64
  ;;
esac
