#!/usr/bin/env bash
#
# ime-route -- lai bo go o MAY NAO DANG GIU BAN PHIM, khong phai may nao chay nvim.
#
# Voi `herdr --remote <may>`, nvim chay o mot may con ban phim o may khac: bo go
# cua may CO BAN PHIM bien phim thanh tieng Viet TRUOC khi byte di qua SSH.
# tongue.nvim chi lai duoc bo go cua may no dang chay, nen khong co script nay no
# doi input source cua may sai -- dung y thiet ke, sai may. Do 19/08/2026: nvim
# tren macmini nhay vi->en->vi du thu, rog dung im o keyboard-us suot.
#
# Script nay la mot backend cua tongue.nvim (hop dong 4 khoa), khong phai mot lop
# va vong: no chuan hoa moi may ve chung mot bang tu vung en/vi/zh roi dinh tuyen.
#
#   ime-route get              -> in en | vi | zh | unknown
#   ime-route set <token>      -> dat che do do
#   ime-route exchange <token> -> dat che do do VA in che do CU (mot chang ssh)
#   ime-route where            -> in dich dang dung (de go roi / checkhealth)
#
# KIEN TRUC: mot script, hai vai.
#
#   LEAF  -- tra loi ve CHINH may dang chay no, bang cong cu may do co: `tongue`
#            tren macOS, `fcitx5-remote` tren Linux. Day la noi duy nhat biet
#            ten bo go that (`lotus`, `keyboard-us`, input source cua macOS).
#   ROUTER-- khong tu tra loi, ma `ssh` sang may giu ban phim va goi CHINH NO o
#            do voi IME_ROUTE_LEAF=1.
#
# Vi sao goi lai chinh no thay vi hardcode lenh cua dau kia: ban dau nhanh remote
# hardcode `fcitx5-remote`, nen ban phim o mot may macOS la hong
# (`command not found: fcitx5-remote`, do 20/08/2026 voi client airm3). May kia
# la may duy nhat biet no co gi.
#
# IME_ROUTE_LEAF=1 la BAT BUOC, khong phai toi uu: mot phien ssh den lam
# SSH_CONNECTION cua may dich tro NGUOC ve may goi, nen khong co co thi no ssh
# tra lai va nay vo han. Do 20/08/2026: `ssh airm3 ime-route where` tu macmini
# in ra `remote: macmini`.

set -uo pipefail

# Ten input method phia fcitx5. Group cua rog dung co hai muc nay; may khac thi
# ghi de bang bien moi truong thay vi sua file.
EN_IM=${IME_ROUTE_EN_IM:-keyboard-us}
VI_IM=${IME_ROUTE_VI_IM:-lotus}

# Duong dan cua chinh script nay tren may dau kia. `repoPath` luon la $HOME/.nix
# (bat bien cua repo), va `~` duoc shell CUA DAU KIA no ra -- ten user khac nhau
# giua cac may (kln / lenamkhanh) nen khong duoc viet cung.
LEAF_PATH='~/.nix/home-manager/programs/nvim/bin/ime-route'

# Mot lan `uname` cho ca script. `leaf_tool` va `bridge_ip` truoc day moi cai hoi
# lai, va moi fork o day nam tren duong nong: khoi phat hien tuyen chay cho CA
# `get` LAN `set`, tuc hai lan moi lan bam Esc.
OS=$(uname -s)

# Thu muc tam RIENG cua user. Tren macOS $TMPDIR la 0700 duoi /var/folders, con
# /tmp la 1777 dung chung -- va macOS khong co fs.protected_symlinks. Ca file
# nhat ky lan cache deu dung day.
TMP=${TMPDIR:-/tmp}

# ---------------------------------------------------------------- vai LEAF ---

# fcitx5-remote qua ssh khong co DBUS_SESSION_BUS_ADDRESS san, va thieu no thi no
# im lang khong lam gi. Chi dat khi CHUA co, de phien do thi thang.
fcitx5() { DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus} fcitx5-remote "$@"; }

have() { command -v "$1" >/dev/null 2>&1; }

# Do cong cu TRONG PHAM VI nen tang, khong probe theo ten lenh tran: tren
# crates.io co mot `tongue` la chuong trinh HOAN TOAN KHAC, va repo nay co tien
# su binary cu o `~/.local/bin` che ban nix. Hom nay khong may nao co ca hai
# (do: rog khong co tongue, airm3 khong co fcitx5-remote) nen THU TU probe khong
# phai cau hoi -- cai quan trong la khong goi nham mot chuong trinh trung ten
# voi argv `vi`.
leaf_tool() {
  case $OS in
  Darwin) have tongue && { echo tongue; return 0; } ;;
  Linux) have fcitx5-remote && { echo fcitx5-remote; return 0; } ;;
  esac
  return 1
}

leaf_get() {
  case $(leaf_tool) in
  tongue)
    # Y het preset `tongue` cua tongue.nvim: goi tran de doc. No tu in en|vi|zh
    # hoac `unknown`, nen khong can chuan hoa gi them.
    tongue
    ;;
  fcitx5-remote)
    local im
    im=$(fcitx5 -n 2>/dev/null)
    case "$im" in
    # `-n` can mot input context dang focus; khong co thi no in RONG va van
    # thoat 0. Tra `unknown` thay vi de rong: rong bi sanitize cua plugin loai
    # voi ly do "empty output", con `unknown` la tin hieu co nghia trong hop dong.
    "") echo unknown ;;
    "$EN_IM") echo en ;;
    "$VI_IM") echo vi ;;
    # Mot IM THU BA khong duoc doan thanh `vi`. Truoc 20/08/2026 o day la
    # `*) echo vi`, dung CHI VI group cua rog vua van co dung hai muc. Da tai
    # hien tren may: them `keyboard-fr` vao group roi chuyen sang no -> bao `vi`
    # -> plugin ghi nho "tieng Viet" -> khoi phuc bang cach bat `lotus`, tuc am
    # tham da nguoi dung tu tieng Phap sang tieng Viet.
    #
    # `unknown` la cau tra loi dung: bang tu vung en|vi|zh khong co ten cho no,
    # va hop dong cua plugin coi `unknown` la "khong biet may dang o dau" nen no
    # se KHONG nho de khoi phuc. Cai gia: roi nvim thi khong duoc tra ve tieng
    # Phap. Doi lay viec khong bi da sang mot ngon ngu khac -- ro rang hon.
    *) echo unknown ;;
    esac
    ;;
  *)
    echo "ime-route: $(hostname -s) khong co cong cu bo go nao" >&2
    return 1
    ;;
  esac
}

leaf_set() {
  case $(leaf_tool) in
  tongue)
    # Khong doc lai o day, va do la co y: `tongue bogus` da thoat 2 kem thong
    # bao (do tren airm3). Them mot lan doc chi la chi phi khong mua gi.
    tongue "$1" >/dev/null
    ;;
  fcitx5-remote)
    local name
    case "$1" in
    en) name=$EN_IM ;;
    vi) name=$VI_IM ;;
    # fcitx5 ben nay khong co tieng Trung. Bao that bai de plugin kiem chung
    # bang mot lan doc thay vi im lang khong lam gi.
    *)
      echo "ime-route: '$1' khong co tren $(hostname -s)" >&2
      return 3
      ;;
    esac
    fcitx5 -s "$name" >/dev/null
    # `-s <ten khong ton tai>` THOAT 0 va khong doi gi -- do tren rog: truoc
    # `lotus`, `-s khongcothat` cho rc=0 khong in gi, sau van `lotus`. Khong co
    # API nao liet ke IM kha dung (`-q` chi tra ten GROUP), nen doc lai la cach
    # DUY NHAT biet lenh co an hay khong.
    [ "$(fcitx5 -n 2>/dev/null)" = "$name" ] || {
      echo "ime-route: dat '$name' khong an tren $(hostname -s)" >&2
      return 3
    }
    ;;
  *)
    echo "ime-route: $(hostname -s) khong co cong cu bo go nao" >&2
    return 1
    ;;
  esac
}

# -------------------------------------------------------------- vai ROUTER ---

# IP client theo tien trinh bridge cua herdr -- nguon tin dung khi DANG o trong
# mot pane herdr. Rong = khong co client tu xa nao attach.
# Cac bridge dang song, TRE NHAT truoc: "<giay da chay> <pid>" moi dong.
# `etimes` KHONG co tren macOS va im lang tra nham cot (da thu), nen phai doi
# `etime` (dd-hh:mm:ss | hh:mm:ss | mm:ss) ra giay bang tay.
bridges() {
  ps -eo pid,etime,args | awk '
    function secs(e,  n, a, d) {
      d = 0
      if (e ~ /-/) { split(e, a, "-"); d = a[1]; e = a[2] }
      n = split(e, a, ":")
      return (n == 3) ? ((d * 24 + a[1]) * 60 + a[2]) * 60 + a[3] : (d * 24 * 60 + a[1]) * 60 + a[2]
    }
    # Neo vao TOAN BO argv, khong phai vao hai token cuoi. Hai vong that bai
    # da do, moi cai chat hon cai truoc:
    #   `/[r]emote-client-bridge/` -- khop chuoi con trong argv BAT KY; mot
    #     tien trinh thu ba mang chuoi nay lot ngay (tai hien: long 4 ung vien).
    #   `$NF/$(NF-1)` -- van khop `ssh ... -T macmini exec .../herdr
    #     remote-client-bridge`, tuc lenh ssh DI RA cua mot may dang lam
    #     CLIENT. Do tren rog 20/08/2026: no khop pid 20570, va CHI thoat nan
    #     vi environ cua ssh do doc ra rong. Neu herdr o do duoc khoi dong tu
    #     mot phien ssh thi ssh ay MANG hoa thach, va may se dinh tuyen ve
    #     dung may sai -- con bug ma ca script nay sinh ra de giet.
    # Bridge THAT la mot tien trinh herdr voi dung mot tham so, nen NF==4 voi
    # `ps -eo pid,etime,args`. Do ca hai dau: macmini (server) NF=4 $3=.../herdr;
    # rog (client) NF=16 $3=ssh.
    NF == 4 && $4 == "remote-client-bridge" && $3 ~ /(^|\/)herdr$/ { print secs($2), $1 }

    # Duong THU HAI, va tren Windows la duong DUY NHAT: nguoi dung `ssh macmini`
    # roi go `herdr` -- attach thuong, khong sinh bridge nao. `herdr --remote`
    # khong co tren Windows, nen truoc dong nay a14 KHONG BAO GIO duoc dat ten:
    # `bridges` rong -> `targets` rong -> router im lang lai bo go cua CHINH
    # macmini, dung con bug ca script sinh ra de giet. Do 20/08/2026: mot phien
    # a14 dang mo ma `ime-route where` van in `remote: rog`.
    #
    # Ba hinh dang attach, lay tu `herdr --help`; allowlist chu khong blocklist
    # vi moi subcommand khac (`api`, `config`, `workspace`, ...) cung chay trong
    # phien ssh va cung mang SSH_CONNECTION -- mot blocklist se de lot chung.
    NF == 3 && $3 ~ /(^|\/)herdr$/                              { print secs($2), $1 }
    NF == 5 && $4 == "--session" && $3 ~ /(^|\/)herdr$/         { print secs($2), $1 }
    NF == 6 && $4 == "session" && $5 == "attach" && $3 ~ /(^|\/)herdr$/ { print secs($2), $1 }
  ' | sort -n
}

# IP client cua mot tien trinh bridge. `ps -E` in ca environ sau argv, va
# SSH_CONNECTION la "<client-ip> <client-port> <server-ip> <server-port>", nen
# tach theo khoang trang thi truong ngay sau dau `=` chinh la IP client.
# Duong doc environ khac nhau theo he dieu hanh va KHONG suy duoc tu nhau:
# `ps -E` la co phap BSD; tren Linux (procps-ng 4.0.6) no thoat 1 voi
# "error: unsupported SysV option" -- do tren rog 20/08/2026. Truoc day stderr do
# bi `2>/dev/null` nuot, nen ham tra RONG va router IM LANG tu coi minh la leaf:
# dung con bug script nay sinh ra de sua, chi doi chieu.
#
# Hai duong tra ve HAI HINH DANG khac nhau, da do ca hai:
#   Darwin: `ps -E` noi environ vao sau argv bang KHOANG TRANG, nen tach theo
#           khoang trang xong thi gia tri chi con dung IP.
#   Linux:  /proc/<pid>/environ tach bang NUL, nen gia tri con NGUYEN ca bon
#           truong "<ip> <port> <ip> <port>".
# Vi vay phai chuan hoa o cuoi bang `{ print $1 }` thay vi tin vao mot trong hai.
bridge_ip() {
  case $OS in
  Darwin) ps -E -p "$1" -o command= 2>/dev/null | tr ' ' '\n' ;;
  *) tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null ;;
  esac | awk -F= '$1 == "SSH_CONNECTION" { print $2; exit }' | awk '{ print $1 }'
}

# Ten Host cua MOI client dang attach, tre nhat truoc, moi ten mot dong.
#
# Nhieu client cung attach vao MOT herdr server la chuyen co that -- rog va
# airm3 cung luc, do 20/08/2026 -- va herdr khong noi pane nao thuoc client nao
# (`herdr api snapshot` khong co mot khoa client/remote/host/origin nao, da tim
# ky). Truoc day o day la mot heuristic "chon cai tre nhat", tuc mot lan DOAN.
#
# Khong can doan: `set` di toi TAT CA. Nguoi dung chi go o mot may, nhung ta
# khong biet may nao -- dat ca hai thi may HO DANG GO chac chan dung, con may
# kia doi trang thai trong luc khong ai go o do, vo hai. Doan sai thi ngc lai:
# may ho dang go khong doi gi ca, dung cai loi da duoc bao cao.
#
# `get` van doc tu cai tre nhat: `set` giu chung dong bo nen doc cai nao cung
# the, va mot lan doc thi re hon N lan.
bridge_hosts() {
  local secs pid ip host
  bridges | while read -r secs pid; do
    ip=$(bridge_ip "$pid")
    [ -n "$ip" ] || continue
    host=$(ssh_host_for "$ip")
    [ -n "$host" ] && printf '%s\n' "$host"
  done | awk 'NF && !seen[$0]++'
}

# Cai tren tra loi mot cau ve TRANG THAI MAY, khong ve phien goi -- va no ton
# 45 ms (do tren macmini: `ps -eo pid,etime,args` quet 799 tien trinh mat 24 ms,
# `bridge_ip` va `ssh_host_for` moi bridge them 5 ms nua). Moi lan bam Esc thi
# tongue.nvim goi backend HAI lan tuan tu, nen cai gia do tra hai lan cho cung
# mot cau tra loi.
#
# TTL rat ngan la co y: no chi de gop hai lan goi cua CUNG mot lan bam phim, chu
# khong phai de nho lau. Bridge doi theo phut/gio, nen 2 giay khong the lech --
# va neu co lech thi `set` fan-out toi ca danh sach cu, tuc cung lam mot viec vo
# hai o may khong ai go.
#
# Chi cache nhanh herdr. Nhanh SSH_CONNECTION la thuoc tinh CUA PHIEN, khong phai
# cua may, nen cache no la tron lan cac phien khac nhau.
CACHE_TTL=${IME_ROUTE_CACHE_TTL:-2}
CACHE=$TMP/ime-route.bridges.$(id -u)

mtime() { case $OS in Darwin) stat -f %m "$1" ;; *) stat -c %Y "$1" ;; esac 2>/dev/null; }

bridge_hosts_cached() {
  local now age mt
  # `-O` (do minh so huu) va `! -L` (khong phai symlink): cache nam trong $TMPDIR
  # 0700 nen day la dai phong thu thu hai, khong phai thu nhat.
  if [ "$CACHE_TTL" -gt 0 ] 2>/dev/null && [ -f "$CACHE" ] && [ -O "$CACHE" ] && [ ! -L "$CACHE" ]; then
    now=$(date +%s)
    # Cache co the bien mat GIUA `[ -f ]` va `mtime` -- luc do `mtime` in ra rong,
    # va `$((now - ))` la loi cu phap so hoc khien `age` khong duoc gan, roi
    # `set -u` giet ca script o dong sau. Duong nay chay moi lan bam Esc nen mot
    # ca hiem van se gap. Rong -> coi nhu cu.
    mt=$(mtime "$CACHE")
    [ -n "$mt" ] || mt=0
    age=$((now - mt))
    if [ "$age" -ge 0 ] && [ "$age" -lt "$CACHE_TTL" ]; then
      cat "$CACHE"
      return 0
    fi
  fi
  local out
  out=$(bridge_hosts)
  # Ghi qua file tam roi `mv`: mot lan goi song song khong bao gio doc phai file
  # viet do dang. `mv` trong cung filesystem la nguyen tu.
  if [ "$CACHE_TTL" -gt 0 ] 2>/dev/null; then
    local tmpc
    tmpc=$(mktemp "$CACHE.XXXXXX" 2>/dev/null) &&
      printf '%s\n' "$out" >"$tmpc" 2>/dev/null &&
      mv -f "$tmpc" "$CACHE" 2>/dev/null || rm -f "$tmpc" 2>/dev/null
  fi
  printf '%s\n' "$out"
}

# IP client theo SSH_CONNECTION cua CHINH phien nay.
own_client_ip() {
  [ -n "${SSH_CONNECTION:-}" ] || return 1
  set -- $SSH_CONNECTION
  printf '%s\n' "$1"
}

# Ten Host trong ~/.ssh/config co HostName trung IP nay. Doc lai tu do thay vi
# giu mot bang IP rieng o day -- ssh config da la nguon chan ly cho viec nay.
ssh_host_for() {
  awk -v ip="$1" '
    tolower($1) == "host"                                  { host = $2 }
    tolower($1) == "hostname" && $2 == ip && host != ""    { print host; exit }
  ' ~/.ssh/config
}

# May KHONG lai duoc bo go qua ssh -- loc TRUOC khi mo ket noi.
#
# Windows: sshd la SERVICE nen shell no sinh ra nam o SESSION 0, con bo go (VKey)
# song o SESSION 1. `tongue.exe` lai VKey bang PostMessage(FindWindow) va doc
# trang thai qua shared memory `Local\VKeySharedState`; ca hai deu la tai nguyen
# THEO SESSION.
#
# BUC TUONG DO NAY DA VUOT DUOC, va dong nay tung noi nguoc lai nen phai sua:
# tongue 74be163 them `tongue agent` -- mot tien trinh song trong session desktop
# nghe `\\.\pipe\tongue-<user>`, va moi loi goi tu session 0 tu chuyen tiep vao
# do. `\\.\pipe\` KHONG theo session. Da trien khai tren a14 (task `TongueAgent`,
# `windows/modules/services/tongue-agent`): `ssh a14 tongue vi` chay that, 5/5.
#
# Van BO QUA a14, va gio ly do la DUONG TRUYEN chu khong phai buc tuong.
#
# Moi lan roi Insert ton HAI loi goi backend TUAN TU (plugin dat `observe` tren
# duong ra nen bo nhanh nhanh), va mot luot ssh sang a14 ton 364-587 ms co
# ControlMaster / 586 ms khong co. Buoc qua pipe thi gan nhu mien phi -- do
# 20/08/2026: `ssh a14 tongue status` tron ven 656 ms, tuc phan cua tongue va
# ca cau pipe chi ~69 ms. Nhung hai luot van la ~870-1320 ms cho mot lan bam
# Esc, trong khi cua so can bao ve la 150-400 ms. Van lech mot bac do lon.
#
# Khoang 364-587 ms KHONG phai nhieu do: a14 dat `Minimum processor state` =
# AC 48% / DC 0%, nen xung nhip tut ve 710-1670 MHz luc ranh va mot tien trinh
# ngan ket thuc truoc khi governor kip keo len. Ghi kem trang thai nguon vao
# moi so do o day, hoac dung ghi so nao ca.
#
# Fan-out song song ben duoi KHONG cuu duoc ca nay: no gop cac dich cua CUNG mot
# lenh, con `get` roi `set` thi van noi tiep nhau.
#
# Va cho ai dinh toi uu tiep: CHO CHAM KHONG NAM O TONGUE. Do 20/08/2026, xen ke
# 9 cap de triet tieu troi: `ssh a14 exit` (chi ssh + shell dang nhap) da ton
# 430 ms, con `ssh a14 tongue status` tron ven 495 ms -- tuc phan cua tongue va
# ca cau pipe chi ~65 ms, 13%. De doi chieu: `ssh rog true` het 45 ms.
#
# Thu phao that su la shell dang nhap, va no chiem 82% mot luot. `DefaultShell`
# cua sshd tren a14 la `pwsh.exe` voi `DefaultShellCommandOption = -c` -- KHONG
# co `-NoProfile`, nen moi lenh tu xa nap du profile. Do TAI CHO khi cam sac,
# median 9 lan: `cmd /c exit` 10 ms, `powershell -NoProfile` 105 ms,
# `pwsh -NoProfile` 169 ms, `pwsh` CO profile 293 ms. Ngan sach mot luot 364 ms
# = 293 shell + 64 transport + ~7 con lai; 64 ms do bang rog (62 ms TONG), tuc
# phan ssh va mang cua a14 khong he cham -- chi shell cham.
#
# Doi DefaultShell sang cmd.exe cat ~283 ms moi luot va dua vao trong cua so,
# khong mot dong code. Nhung profile chinh la thu nap secrets, `update` va alias
# cho MOI lenh tu xa lan `scp`/`sftp` (windows/tests/update.Tests.ps1 gac dieu
# do), nen day la quyet dinh cua chu may chu khong phai mot toi uu cua ime-route.
# Duong lui re hon -- them `-NoProfile` vao `DefaultShellCommandOption` -- la
# BAT KHA THI, khong phai chua thu: sshd nhet ca chuoi vao MOT o argv, pwsh nhan
# no lam mot token va thoat 64.
#
# Nen `tongue agent` mua TAM VOI (`ssh a14 tongue vi` cho script va tu dong hoa)
# chu khong mua toc do, va dong SKIP_HOSTS nay o lai.
#
# Loc theo TEN chu khong probe: probe chinh la cai dat. `-` chu khong `:-` de
# `IME_ROUTE_SKIP=` tat han duoc bo loc; voi `:-` thi chuoi rong roi ve mac dinh
# va cai cong tat nay im lang khong lam gi.
SKIP_HOSTS=${IME_ROUTE_SKIP-a14 rog-win}

routable() {
  local h
  for h in $SKIP_HOSTS; do [ "$1" = "$h" ] && return 1; done
  return 0
}

# Hoi ai la CO Y, khong phai thu lan luot: cac nguon tin nay mau thuan nhau
# thuong xuyen, va chon nham thi im lang.
#
#   IME_ROUTE_LEAF -> khong hoi ai. May goi da quyet dinh roi; hoi tiep la nay
#     nguoc ve chinh no.
#   trong pane herdr -> HOI BRIDGE. SSH_CONNECTION o day la hoa thach cua luc
#     herdr server khoi dong, con nguyen ca khi nguoi dung ngoi ngay truoc may.
#     Khong co bridge nghia la dang attach cuc bo => ban phim o day.
#   ngoai herdr -> DUNG SSH_CONNECTION CUA CHINH MINH. Day moi la phien that su
#     dang cho nguoi ta go.
#
# Con lai mot ca chua phu: tmux/screen ngoai herdr de lai hoa thach y het, nhung
# chung khong co tien trinh "bridge" nao de hoi, nen khong co nguon tin nao dung
# hon. `where` in ro no theo nguon nao de con chan doan duoc.
# Verb `leaf-*` ep vai LEAF, va no thay cho bien moi truong vi DUY NHAT mot ly
# do: HUONG HONG. Mat bien -> may kia thay SSH_CONNECTION tro nguoc ve day roi
# ssh lai -> lap vo han (do 20/08/2026: ca rog lan airm3 deu in `remote: macmini`).
# Gap verb la khong biet -> `*)` -> exit 64, dung ngay. Fail-open doi thanh
# fail-closed.
#
# Van doc IME_ROUTE_LEAF: mot ROUTER ban cu goi mot LEAF ban moi thi con dung
# bien do. Nho vay trien khai duoc theo BAT KY thu tu nao giua cac may -- va
# lech ban giua cac may la co that, khong phai gia dinh.
cmd=${1:-}
case "$cmd" in
leaf-get)
  cmd=get
  IME_ROUTE_LEAF=1
  ;;
leaf-set)
  cmd=set
  IME_ROUTE_LEAF=1
  ;;
leaf-exchange)
  cmd=exchange
  IME_ROUTE_LEAF=1
  ;;
esac

# Nhat ky chan doan, TAT theo mac dinh va bat bang cach TAO FILE:
#   : > "${TMPDIR:-/tmp}/ime-route.log"
# Bat theo su ton tai cua file chu khong theo bien moi truong la co chu dich --
# argv cua backend duoc ghim luc `setup()`, nen khong the them bien cho mot nvim
# dang chay; nhung script nay thi duoc doc lai o MOI loi goi, nen tao file la
# lam mot phien dang mo bat dau ghi ngay. Xoa file la tat.
#
# $TMPDIR chu khong phai /tmp: tren macOS /tmp la /private/tmp mode 1777 dung
# chung, va macOS khong co fs.protected_symlinks. Voi ten co dinh o do thi mot uid
# khac vua BAT duoc nhat ky cua nguoi khac (chi can tao file) vua doc duoc no --
# ma nhat ky ghi moi lan bam Esc mot dong, tuc mot oracle hoat dong/idle kha min,
# kem ten client dang attach. $TMPDIR tren macOS la 0700 duoi /var/folders.
LOG=${IME_ROUTE_LOG:-$TMP/ime-route.log}

# Chi ghi vao file CUA MINH va khong theo symlink -- dai phong thu thu hai sau
# $TMPDIR, vi `IME_ROUTE_LOG` van tro ra cho khac duoc.
log_enabled() { [ -f "$LOG" ] && [ -O "$LOG" ] && [ ! -L "$LOG" ]; }

# Co phai luot chay nay se DUNG toi chuoi chan doan khong? Chi khi do moi bo tien
# tinh `skipped`/`n`/`via` day du -- xem khoi phat hien tuyen ben duoi.
diagnosing() { [ "$cmd" = where ] || log_enabled; }

target=""    # dich de DOC (tre nhat)
targets=""   # moi dich de DAT, moi ten mot dong
skipped=""   # client dang attach nhung KHONG lai duoc -- chi de chan doan
no_route=""  # co client, ma khong cai nao lai duoc -> KHONG duoc lui ve leaf
via=""
if [ -n "${IME_ROUTE_LEAF:-}" ]; then
  via="leaf (ep cuc bo)"
elif [ -n "${HERDR_PANE_ID:-}${HERDR_ENV:-}" ]; then
  seen=$(bridge_hosts_cached)
  targets=$(printf '%s\n' "$seen" | while read -r h; do
    [ -n "$h" ] && routable "$h" && printf '%s\n' "$h"
  done)
  target=$(printf '%s' "$targets" | head -1)
  # `skipped`, `n` va `via` chi nuoi CHUOI CHAN DOAN: `where`, va `log()` -- ma
  # `log()` thoat ngay khi khong co file nhat ky. Tinh chung vo dieu kien la ~4 ms
  # moi lan goi cho mot chuoi bi vut. Duong quyet dinh chi can `seen` va `targets`.
  if diagnosing; then
    skipped=$(printf '%s\n' "$seen" | while read -r h; do
      [ -n "$h" ] && ! routable "$h" && printf '%s\n' "$h"
    done | tr '\n' ' ' | sed 's/ $//')
    n=$(printf '%s' "$targets" | grep -c . || true)
    via="herdr bridge"
    [ "${n:-0}" -gt 1 ] && via="herdr bridge ($n client: $(printf '%s' "$targets" | tr '\n' ' ' | sed 's/ $//'))"
    [ -n "$skipped" ] && via="$via [bo qua: $skipped]"
  else
    via="herdr bridge"
  fi
  # Co client ma khong cai nao lai duoc thi KHONG duoc roi xuong nhanh leaf.
  # `targets` rong o day KHAC HAN `targets` rong vi khong co bridge nao: ben kia
  # nghia la dang attach cuc bo (ban phim o ngay day), ben nay nghia la ban phim
  # o mot may ta khong toi duoc. Gop lai thi leaf_set se doi bo go cua MAY NAY --
  # dung con bug ca script nay sinh ra de giet.
  [ -n "$seen" ] && [ -z "$targets" ] && no_route=1
else
  ip=$(own_client_ip) || ip=""
  via="SSH_CONNECTION cua phien"
  if [ -n "$ip" ]; then
    target=$(ssh_host_for "$ip")
    # "Co IP ma khong tra ra ten Host" la trang thai THU BA ve mat NHAN THUC, nhung
    # CO Y khong duoc doi xu rieng ve mat HANH VI: no van roi xuong leaf. Truoc day
    # doan nay noi nguoc lai va ma thi khong lam theo -- sua lai cho khop cai code
    # that su lam, vi ca "sai" o day lai la ca DUNG:
    #
    #   - `Include ~/.colima/ssh_config` tro 127.0.0.1, va loopback thi leaf DUNG la
    #     dich dung.
    #   - Ngoai herdr, `SSH_CONNECTION` con lai co the la hoa thach cua mot phien da
    #     dong (tmux/screen); khong co nguon tin nao dung hon, da ghi o tren.
    #
    # Nen chi doi `via` -- de `where` va nhat ky noi ro da hoi gi roi khong thay --
    # chu khong dat `no_route`. Muon chan that thi phai loc theo dia chi nguon
    # (loopback / link-local), khong phai theo "tra khong ra ten".
    [ -n "$target" ] || via="SSH_CONNECTION cua phien (client $ip KHONG co Host trong ~/.ssh/config)"
    # Cung mot luat cho duong ssh truc tiep: nguoi ta ssh tu a14 vao macmini roi
    # mo nvim, khong qua herdr.
    if [ -n "$target" ] && ! routable "$target"; then
      skipped=$target
      target=""
      no_route=1
      via="$via [bo qua: $skipped]"
    fi
  fi
  targets=$target
fi

# $1 = get|set, $2 = token (da kiem la mot trong en|vi|zh o duoi). Ngoac KEP o
# day la co y: `$1`/`$2` phai no ben NAY, con `~` phai giu nguyen de shell dau
# kia no -- trong ngoac kep, bash khong lam tilde expansion.
# `-n` (stdin tu /dev/null) khong phai trang tri: vong lap `set` doc danh sach
# dich tu stdin, ma ssh MAC DINH doc stdin -- no nuot not cac dong con lai va
# vong lap chi chay dung mot lan. Do 20/08/2026: `set en` chi toi airm3, rog
# dung im, va khong co mot thong bao loi nao.
# tongue.nvim goi backend qua `vim.system(...)` voi mot deadline, ma deadline do
# giet SCRIPT chu khong giet ssh chau. Do 20/08/2026: ban goi truc tiep bi kill
# de lai `ssh ... PPID=1` mo coi; ban chay-nen + trap de lai 0.
#
# KHONG dung `exec ssh`: nhanh `set` fan-out toi NHIEU dich trong mot vong lap
# nen exec se giet vong lap ngay sau dich dau, con nhanh `get` con phai goi log()
# sau khi doc token. `wait` thi bi trap ngat duoc; mot lenh foreground thi khong
# -- bash hoan trap lai den khi no chay xong.
# `vim.system` gui SIGTERM khi het deadline -- DA DO bang mot script mo trap va
# ghi ra file: `got=TERM`. Nen trap la dung cong cu; cai bay nam cho khac.
#
# BAY: `tok=$(remote ...)` chay remote trong mot SUBSHELL. SIGTERM chi toi tien
# trinh con TRUC TIEP cua nvim (script nay), khong toi subshell, nen ssh trong
# do song sot du trap co dung. Do 20/08/2026 truoc khi sua: con 2 ssh sau khi
# nvim thoat (go trap thi 3). Vi vay duong `get` ghi ra FILE TAM thay vi dung
# command substitution -- ssh thanh con truc tiep cua shell CHINH, va trap voi
# toi duoc no.
kid=""
tmpout=""
# `$kid` KHONG duoc ngoac kep: nhanh `set` fan-out song song nen no giu NHIEU pid
# cach nhau bang khoang trang, va can word-splitting de `kill` nhan du danh sach.
# shellcheck disable=SC2086
tmpdir=""

trap '[ -n "$kid" ] && kill -TERM $kid 2>/dev/null; [ -n "$tmpout" ] && rm -f "$tmpout"; [ -n "$tmpdir" ] && rm -rf "$tmpdir"; exit 143' TERM INT

# `-n` (stdin tu /dev/null): vong lap `set` doc danh sach dich tu stdin, ma ssh
# MAC DINH doc stdin -- no nuot not cac dong con lai va vong lap chay dung mot
# lan. Do: `set en` chi toi airm3, rog dung im, khong mot thong bao loi nao.
#
# ServerAliveInterval vi ConnectTimeout chi gac giai doan CONNECT, khong gac luc
# lenh dang chay o dau kia.
remote() { # $1 = host, $2 = get|set, $3 = token
  ssh -n -o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=3 -- "$1" \
    "$LEAF_PATH leaf-$2${3:+ $3}" &
  kid=$!
  wait "$kid"
}

# `|| return 0` chu khong `&&`: khi khong co file log thi `[ -f ]` sai, va mot
# `&&` doan mach lam HAM tra ve 1. `log` la lenh cuoi cua nhanh `get`, nen ca
# script thoat 1 du da in dung token -- va phia goi qua ssh doc dung ma thoat do
# roi coi la that bai. Do 20/08/2026: dau kia in `vi` va rc=1.
log() { log_enabled || return 0; printf '%s pid=%-6s %-22s %s\n' "$(date +%H:%M:%S)" "$PPID" "${via:-?}->${target:-local}" "$*" >>"$LOG"; }

case "$cmd" in
get)
  if [ -n "$no_route" ]; then
    # `unknown` chu khong phai loi, va do la lua chon RE HON. Hop dong coi
    # `unknown` la "khong biet may dang o dau" nen plugin se KHONG nho no de
    # khoi phuc -- dung y muon. Bao loi thay vi the thi backend goi them mot lan
    # `get` kiem chung roi canh bao 30 s mot lan: ba loi goi va mot dong nhac
    # nho, cho mot su that khong doi duoc.
    echo unknown
    log "get -> KHONG DINH TUYEN DUOC (client: $skipped)"
  elif [ -n "$targets" ]; then
    # Thu lan luot, tre nhat truoc. Mot client khong tra loi duoc (may ngu, hoac
    # may Windows khong chay noi script bash) khong duoc lam hong ca lan doc.
    # Dau kia da chuan hoa roi, nen o day khong dien giai gi them.
    tok=""
    tmpout=$(mktemp) || exit 1
    while read -r h; do
      [ -n "$h" ] || continue
      # KHONG `$(remote ...)`: xem chu thich o trap. Ghi ra file roi doc bang
      # `$(<file)` -- builtin, khong fork -- de ssh la con truc tiep cua shell nay.
      if remote "$h" get >"$tmpout" 2>/dev/null; then
        tok=$(<"$tmpout")
        tok=${tok%%[$'\n']*}
        [ -n "$tok" ] && {
          log "get <- $h: $tok"
          break
        }
      fi
      log "get <- $h TRUOT"
      tok=""
    done <<EOF
$targets
EOF
    rm -f "$tmpout"
    tmpout=""
    [ -n "$tok" ] || {
      log "get -> moi dich deu TRUOT"
      exit 1
    }
    printf '%s\n' "$tok"
  else
    out=$(leaf_get) || exit 1
    printf '%s\n' "$out"
    log "get -> ${out:-<rong>}"
  fi
  ;;

set)
  mode=${2:-}
  case "$mode" in
  en | vi | zh) ;;
  # Chan tai day chu khong day sang ssh: token den tu plugin nen luon sach, va
  # mot danh sach trang o cho nay la thu giu cho chuoi lenh ssh khong bao gio
  # mang mot thu khong luong truoc duoc.
  *)
    echo "ime-route: set can mot token (en|vi|zh), nhan duoc '${mode}'" >&2
    exit 2
    ;;
  esac
  if [ -n "$no_route" ]; then
    # Im lang va thoat 0. Bat ky chu nao tren stdout cung bi coi la "noisy" roi
    # keo them mot `get`, con rc khac 0 cung the -- ca hai deu tra tien cho mot
    # viec khong the lam duoc. Day la mot lan im lang CO CHU DICH, va no chi
    # chap nhan duoc vi dieu kien nay VINH VIEN va NOI RA duoc: `where` in ly do
    # day du, log ghi tung lan. Yen luc chay, on ao luc soi.
    log "set $mode -> KHONG DINH TUYEN DUOC (client: $skipped)"
  elif [ -n "$targets" ]; then
    # Toi TAT CA client dang attach. Thanh cong neu it nhat mot cai an -- mot
    # may ngu khong duoc lam hong lan chuyen o may nguoi ta dang go.
    # SONG SONG, khong tuan tu. Vong cu chan o `wait` sau moi dich nen chi phi la
    # TONG cac chang chu khong phai chang dai nhat: do tren macmini 20/08/2026 voi
    # hai client, airm3 94 ms + rog 71 ms = 165 ms thay vi 94 ms.
    #
    # Nang hon ca so ms: chang DAU treo qua deadline 2000 ms cua nvim thi trap
    # ban SIGTERM va dich THU HAI khong bao gio duoc thu -- vi pham dung bat bien
    # "mot may ngu khong duoc lam hong lan chuyen o may nguoi ta dang go" ghi ngay
    # ben tren. Bridge oi (laptop Modern Standby, ControlMaster thanh xac) la ca
    # co that chu khong phai gia thuyet.
    #
    # Van `&` + `wait` chu khong `exec ssh`: ly do o chu thich cua `remote` --
    # trap phai ngat duoc. `kid` nay giu NHIEU pid, nen trap ban ca danh sach.
    rc=1
    jobs_list=""
    while read -r h; do
      [ -n "$h" ] || continue
      ssh -n -o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2 \
        -o ServerAliveCountMax=3 -- "$h" "$LEAF_PATH leaf-set $mode" >/dev/null 2>&1 &
      jobs_list="$jobs_list$!:$h
"
      kid="$kid $!"
    done <<EOF
$targets
EOF
    # `wait` phai chay o shell CHINH (no chi biet job cua chinh no), nen doc bang
    # here-doc chu khong pipe -- pipe se day vong lap vao subshell.
    while IFS=: read -r p h; do
      [ -n "$p" ] || continue
      if wait "$p"; then
        rc=0
        log "set $mode -> $h"
      else
        log "set $mode -> $h TRUOT"
      fi
    done <<EOF
$jobs_list
EOF
    exit "$rc"
  else
    log "set $mode"
    leaf_set "$mode" || exit $?
  fi
  ;;

# Doc VA dat trong MOT chang ssh. Cung hai viec ma `get` roi `set` lam, cung so
# doc tra ve, nhung mot vong thay vi hai -- va mot vong la gan nhu toan bo chi
# phi khi dau kia la Windows: do 20/08/2026 mot chang ton 656 ms, trong do 293 ms
# chi la PowerShell khoi dong truoc khi lam bat cu viec gi.
#
# Plugin chi goi cai nay o DUNG MOT bien -- roi Insert, ep tieng Anh -- vi lenh
# da GHI xong luc cau tra loi ve, nen no chi dung duoc o cho ghi mu la an toan.
# Khoi phuc mot layout da nho thi khong, va duong `get`+`set` giu chieu do.
#
# O LEAF van la hai loi goi, va do la co y: cho dat nam o CHANG SSH chu khong o
# hai lan chay `tongue` cuc bo tren cung mot may.
exchange)
  mode=${2:-}
  case "$mode" in
  en | vi | zh) ;;
  *)
    echo "ime-route: exchange can mot token (en|vi|zh), nhan duoc '${mode}'" >&2
    exit 2
    ;;
  esac
  if [ -n "$no_route" ]; then
    # Y het nhanh `get`: `unknown` nghia la "khong biet may dang o dau", nen
    # plugin se khong nho no de khoi phuc.
    echo unknown
    log "exchange $mode -> KHONG DINH TUYEN DUOC (client: $skipped)"
  elif [ -n "$targets" ]; then
    # Toi TAT CA client, song song -- cung luat voi `set`, va vi cung mot ly do.
    # Khac `get` o cho KHONG duoc break: mot may khong doc duoc van phai duoc DAT.
    tmpdir=$(mktemp -d) || exit 1
    jobs_list=""
    while read -r h; do
      [ -n "$h" ] || continue
      ssh -n -o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2 \
        -o ServerAliveCountMax=3 -- "$h" "$LEAF_PATH leaf-exchange $mode" \
        >"$tmpdir/$h" 2>/dev/null &
      jobs_list="$jobs_list$!:$h
"
      kid="$kid $!"
    done <<EOF
$targets
EOF
    rc=1
    failed=""
    while IFS=: read -r p h; do
      [ -n "$p" ] || continue
      if wait "$p"; then
        rc=0
        log "exchange $mode -> $h"
      else
        failed="$failed$h
"
        log "exchange $mode -> $h TRUOT"
      fi
    done <<EOF
$jobs_list
EOF
    # So doc lay tu dich TRE NHAT tra loi duoc, y het `get`.
    tok=""
    while read -r h; do
      [ -n "$h" ] || continue
      [ -s "$tmpdir/$h" ] || continue
      tok=$(<"$tmpdir/$h")
      tok=${tok%%[$'\n']*}
      [ -n "$tok" ] && break
      tok=""
    done <<EOF
$targets
EOF

    # DUONG LUI, va no BAT BUOC chu khong phai phong xa: dau kia co the dang
    # chay ban ime-route chua biet `leaf-exchange`. Lech ban giua cac may la
    # trang thai BINH THUONG o day -- xem chu thich `LEAF_PATH` dau file -- va
    # khong co duong lui thi Normal mode am tham thoi ve tieng Anh tren dung
    # nhung may cu, tuc mat chinh thu plugin hua.
    #
    # Doc TRUOC khi dat, y het duong cu: chi lam khi chua hoc duoc gi tu mot
    # dich nao khac, nen ca thuong gap (mot client) van la doc-roi-dat chu khong
    # phai ba chang.
    if [ -n "$failed" ]; then
      if [ -z "$tok" ]; then
        while read -r h; do
          [ -n "$h" ] || continue
          if remote "$h" get >"$tmpdir/fallback" 2>/dev/null; then
            tok=$(<"$tmpdir/fallback")
            tok=${tok%%[$'\n']*}
            [ -n "$tok" ] && break
            tok=""
          fi
        done <<EOF
$failed
EOF
      fi
      while read -r h; do
        [ -n "$h" ] || continue
        if remote "$h" set "$mode" >/dev/null 2>&1; then
          rc=0
          log "exchange $mode -> $h (lui ve get+set: ban cu)"
        else
          log "exchange $mode -> $h TRUOT ca duong lui"
        fi
      done <<EOF
$failed
EOF
    fi

    rm -rf "$tmpdir"
    tmpdir=""
    [ "$rc" = 0 ] || {
      log "exchange $mode -> moi dich deu TRUOT"
      exit 1
    }
    printf '%s\n' "${tok:-unknown}"
  else
    # `leaf_get` truot khong duoc lam hong lan DAT: mat so doc chi mat phan hoc,
    # con Normal mode van phai ve tieng Anh.
    out=$(leaf_get) || out=""
    leaf_set "$mode" || exit $?
    printf '%s\n' "${out:-unknown}"
    log "exchange $mode <- ${out:-<rong>}"
  fi
  ;;

where)
  if [ -n "$no_route" ]; then
    # In ra LY DO chu khong chi in trang thai: mot dong "local" se lam nguoi doc
    # tuong khong co client nao, trong khi that ra co ma khong toi duoc.
    echo "KHONG DINH TUYEN DUOC: client dang attach la '$skipped' (Windows)."
    echo '  Khong phai vi khong the -- `tongue agent` da bac cau qua ranh gioi session'
    echo "  bang named pipe, va 'ssh $skipped tongue vi' chay that."
    echo "  Bo qua vi DO TRE: moi lan roi Insert ton hai luot ssh (~900 ms), trong khi"
    echo "  cua so can bao ve la 150-400 ms."
    echo "  => get tra 'unknown', set khong lam gi. Doi che do o may do bang Cap+Q/W/E."
    echo "  Ep thu: IME_ROUTE_SKIP= ime-route where"
  elif [ -n "$target" ]; then
    echo "remote: $target (ban phim o do, theo $via)"
  else
    tool=$(have tongue && echo tongue || { have fcitx5-remote && echo fcitx5-remote || echo "KHONG CO CONG CU"; })
    if [ -n "${IME_ROUTE_LEAF:-}" ]; then
      echo "local: $tool (leaf -- may goi da quyet dinh)"
    else
      # Noi ro DA HOI GI roi khong thay -- "local" mot minh khong phan biet duoc
      # "khong co client tu xa" voi "co ma tra loi sai".
      echo "local: $tool (khong co client tu xa; da hoi: $via)"
    fi
  fi
  ;;

*)
  echo "usage: ime-route get | set <en|vi|zh> | where" >&2
  exit 64
  ;;
esac
