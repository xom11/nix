# vim: ft=swayconfig

set $mod Mod4
set $cap Mod4+Mod1+Ctrl
set $tab Mod4+Ctrl+Shift
set $alt Mod1

font pango:monospace 14

include conf.d/*.conf

# Binding launcher sinh ra tu configs/shortcuts/apps.sway.toml.
include $HOME/.config/sway-nix/launch-app.conf

for_window [app_id=".*"] border pixel 0

xwayland disable
