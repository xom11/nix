font=FiraCode Nerd Font 14
width=480
height=220
margin=16
padding=20
border-size=2
border-radius=14
max-icon-size=64
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right
outer-margin=8

background-color=#1e1e2eCC
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244CC

[urgency=low]
border-color=#a6e3a1
default-timeout=4000

[urgency=normal]
border-color=#89b4fa

[urgency=critical]
border-color=#f38ba8
background-color=#1e1e2eF5
# 20 s — lau hon binh thuong (6 s) de con doc kip, nhung KHONG phai `0`.
# `default-timeout=0` cua mako nghia la KHONG BAO GIO tu tat, va do la mot cai
# bay that chu khong phai tinh chinh: beckon bao loi bang urgency=critical, nen
# 20/08/2026 khi beckon hong (no lai Hyprland bang `dispatch exec ...`, cu phap
# ma ban config Lua da bo) moi lan bam phim tat lai de lai mot the vinh vien.
# Do bang `makoctl list`: the "beckon error" nam nguyen tren man cho toi khi
# co nguoi go tay. Loi dang can biet thi cung khong dang chiem man mai mai.
#
# File nay dung CHUNG cho ca sway lan hyprland (environments/wayland), nen sua
# mot cho la ca hai phien an — khong co ban rieng cho tung phien.
default-timeout=20000
