// vim: ft=kdl
// Khung include; noi dung nam o conf.d/. Ba diem de nham:
//
// 1. Phim quan ly cua so la MAC DINH upstream, khong dich tu sway/hyprland
//    (niri la scrollable-tiling, khong co container tree). Tra cuu trong phien
//    bang Mod+Shift+/.
// 2. launch-app.kdl do home-manager SINH LUC EVAL: sua TOML thi phai switch;
//    sau switch niri tu live-reload (sway/hyprland van phai Tab+r).
// 3. Live-reload toan bo cay include; config hong thi giu ban cu — doc loi
//    bang `niri validate`.
//
// Thu tu include CO Y NGHIA: bind trung GIUA CAC FILE thi dinh nghia sau thang,
// TRONG CUNG FILE la loi cung. ~/.config/niri la symlink ca thu muc vao repo
// nen include tuyet doi ben duoi van tro ve cay nay.

// Launcher bindings, sinh tu configs/shortcuts/launch-app.toml.
include "~/.config/niri-nix/launch-app.kdl"

include "~/.config/niri/conf.d/system.kdl"
include "~/.config/niri/conf.d/shortcuts.kdl"
include "~/.config/niri/conf.d/tab.kdl"
