// =============================================================================
// system.kdl — doi ung sway.d/conf.d/system.conf / hypr.d/conf.d/system.lua.
// Input, layout, dich vu nen, nap lung, GPU va nhom phim nguon may.
// =============================================================================

// -----------------------------------------------------------------------------
// Input — so lieu bung nguyen tu sway.d/conf.d/system.conf.
// `repeat-rate` cua niri cung don vi voi `repeat_rate` cua sway (ky tu/giay).
// niri tach san touchpad/mouse nen giu duoc accel rieng cho tung loai, thu ma
// ban hyprland da phai gop lam mot `sensitivity`.
// -----------------------------------------------------------------------------
input {
    keyboard {
        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        dwt
        natural-scroll
        middle-emulation
        accel-speed -0.3
        scroll-method "two-finger"
    }

    mouse {
        accel-speed -0.2
    }
}

layout {
    gaps 0

    // Ca hai TAT, cho khop sway.d (`for_window [app_id=".*"] border pixel 0`)
    // va hypr.d (`border_size 0`).
    //
    // Doi lai: niri khong con dau hieu nao chi ra cua so dang focus. Neu thay
    // kho dung thi xoa dong `off` trong `focus-ring` — do la mot tu, va niri
    // live-reload nen an ngay.
    focus-ring {
        off
    }

    border {
        off
    }
}

// Tat toan bo animation — cho khop hypr.d (`animations.enabled = false`) va
// sway (khong co san). Ten loai doc tu binary 26.04: co duoi `-movement`,
// khai wiki moi hon dung `window-move` thi bi tu choi.
animations {
    window-open {
        off
    }
    window-close {
        off
    }
    window-movement {
        off
    }
    window-resize {
        off
    }
    workspace-switch {
        off
    }
    horizontal-view-movement {
        off
    }
}

// -----------------------------------------------------------------------------
// Dich vu nen — cung danh sach voi hypr.d/conf.d/system.lua.
//
// Khong can lo chuyen chay chong nhu ben hyprland (`exec` vs `exec-once`):
// spawn-at-startup cua niri chi chay mot lan luc khoi dong phien, live-reload
// KHONG chay lai chung.
//
// CO Y KHONG co `spawn-at-startup "fcitx5"`: home-manager (i18n.inputMethod)
// da ship san unit `fcitx5-daemon.service` co `After=graphical-session.target`
// va no tu chay luc login. Do 22/08/2026: hai nguon cung bat la DUA NHAU —
// instance cua unit mat cuoc roi chet, keo theo instance con sot mat addon
// `waylandim` => khong go duoc tieng Viet o moi app cho den khi kill va bat
// fcitx5 lai tay. Mot nguon duy nhat: de unit systemd lo.
//
// `autotiling` khong co o day: no la cong cu rieng cua sway (goi khai trong
// sway/default.nix), va niri tu xep cot nen khong co viec gi de lam.
// -----------------------------------------------------------------------------
// Noctalia so huu notification daemon, lock screen, idle, wallpaper va
// monitor profile -- dung chung voi sway.d va hyprland.d tu 22/08/2026.
// (truoc do la mako/kanshi/swayidle/swaylock/swaybg -- da goi khoi
// shared/wayland, xem attic/wayland-legacy-tools-2026-08-22.)
spawn-at-startup "noctalia-shell"
spawn-sh-at-startup "wl-paste --watch cliphist store"

// kanshi da goi (2026-08-22). Sua comment cu o day da bao "Noctalia qua
// wlr-output-management dam nhan monitor profile" — SAI voi ban nixpkgs dang
// chay (v4.7.7 khong co service nao dung protocol do, kiem trong source).
// Quan ly output thu cong: `niri msg output` (native), GUI: wdisplays
// (rog/home.nix). Muon profile tu dong theo cam/rut thi phai mang kanshi ve.
// Neu can mode cung: `output "HDMI-A-1" { mode "3840x2160@60"; scale 2; }`,
// va nho `off` la TINH, y het bay cua hyprland.

// Idle timers + lock screen thuoc Noctalia (spawn o tren). Niri tu bat lai
// man hinh khi co input nen khong con `resume` gi can lam.

// -----------------------------------------------------------------------------
// Nap lung — sway dung `bindswitch lid:on`, hyprland dung `bindl switch:on:...`
// (ten thiet bi phai khop may). niri co section rieng va khong can ten thiet bi.
// Rang buoc cua niri: switch-events CHI nhan action `spawn`.
// -----------------------------------------------------------------------------
switch-events {
    lid-close { spawn "systemctl" "suspend"; }
}

// -----------------------------------------------------------------------------
// Nguon may — cung dong rofi Yes/No voi system.conf/system.lua.
// -----------------------------------------------------------------------------
binds {
    Mod+Alt+Shift+L hotkey-overlay-title="Thoát phiên niri?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Exit niri session?' | grep -q Yes && niri msg action quit"; }
    Mod+Alt+Shift+R hotkey-overlay-title="Khởi động lại?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Reboot the system?' | grep -q Yes && systemctl reboot"; }
    Mod+Alt+Shift+S hotkey-overlay-title="Tắt máy?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Shutdown the system?' | grep -q Yes && systemctl poweroff"; }
    Mod+Alt+Shift+H hotkey-overlay-title="Hibernate?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Hibernate the system?' | grep -q Yes && systemctl hibernate"; }
}

// -----------------------------------------------------------------------------
// GPU render -- cung mot benh da sua cho Hyprland ngay 19/08/2026, xem
// hosts/rog/nvidia.nix va hypr.d/hyprland.conf.
//
// HDMI cua rog noi vao NVIDIA, con Intel chi giu eDP-1 (da tat). Nhung ca
// wlroots lan smithay deu chon GPU chinh theo `boot_vga`, ma do tren may:
//   0000:00:02.0 (Intel)  boot_vga=1
//   0000:01:00.0 (NVIDIA) boot_vga=0
// nen mac dinh niri se ve tren Intel roi chep sang NVIDIA de xuat hinh -- dung
// duong da lam Hyprland giat chuot.
//
// niri KHONG co bien moi truong cho viec nay (quet chuoi trong binary 26.04:
// chi co NIRI_CONFIG / NIRI_SOCKET / SMITHAY_USE_LEGACY), nen phai khai o day.
// Va no nhan RENDER node chu khong phai card node -- khac AQ_DRM_DEVICES cua
// Hyprland va WLR_DRM_DEVICES cua sway, ca hai deu nhan card node.
//
// `/dev/dri/nvidia-render` la symlink do udev sinh (hosts/rog/nvidia.nix).
// Dung ten do chu khong dung `/dev/dri/renderD129`: so do la vo tinh.
//
// CANH BAO: `debug` la bac API thap nhat cua niri -- wiki ghi ro no "khong
// duoc bao ve boi chinh sach breaking change" va "co the doi hoac ngung chay
// bat cu luc nao". Neu mot ban niri moi lam phien khong len, day la cho dau
// tien can xem. CHUA AI VAO PHIEN NIRI TREN MAY NAY, nen khoi duoi day chua
// duoc kiem tren thuc te -- khac hai session kia.
// -----------------------------------------------------------------------------
debug {
    render-drm-device "/dev/dri/nvidia-render"
}
