// Input, dich vu nen, nap lung, GPU. So lieu input lay nguyen tu sway.d;
// niri tach touchpad/mouse nen giu duoc accel rieng tung loai.
input {
    keyboard {
        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        dwt
        natural-scroll
        middle-emulation
        accel-speed -0.3
        scroll-method "two-finger"
    }

    mouse {
        accel-speed -0.2
    }
}

layout {
    gaps 0

    // Khop sway.d/hypr.d (border 0). Doi lai: khong con dau hieu nao chi ra
    // cua so focus — thay kho dung thi xoa dong `off` trong focus-ring.
    focus-ring {
        off
    }

    border {
        off
    }
}

// Ten animation doc tu binary 26.04: phai co duoi `-movement`, khai wiki
// (`window-move`) bi tu choi.
animations {
    window-open {
        off
    }
    window-close {
        off
    }
    window-movement {
        off
    }
    window-resize {
        off
    }
    workspace-switch {
        off
    }
    horizontal-view-movement {
        off
    }
}

// spawn-at-startup chay mot lan luc khoi phien, live-reload khong chay lai.
//
// CO Y KHONG spawn fcitx5: unit `fcitx5-daemon.service` cua home-manager tu
// chay luc login; hai nguon cung bat la DUA NHAU — instance thua chet keo mat
// addon `waylandim`, mat tieng Viet cho den khi kill fcitx5 lam lai.
//
// Noctalia so huu notification, lock, idle, wallpaper (spawn o tren).
spawn-at-startup "noctalia-shell"
spawn-sh-at-startup "wl-paste --watch cliphist store"

// Noctalia v4.7.7 KHONG co output management (kiem trong source) — quan ly
// man hinh bang `niri msg output` hoac wdisplays (rog/home.nix). `off` la
// TINH, y het bay cua hyprland. Muon profile tu dong thi mang kanshi ve.

// Man 4K noi HDMI (cung output ma hyprland.lua do scale 2): scale nguyen 2
// nen khong gian 1920x1080 van net. Live-reload an ngay khi luu file.
// eDP-1 tat TINH nhu hyprland.lua — rut HDMI la mo phiên, phuc hoi qua SSH
// hoac login GNOME.
output "HDMI-A-1" {
    mode "3840x2160@60"
    scale 2
}

output "eDP-1" {
    off
}

// switch-events CHI nhan action `spawn`; khong can ten thiet bi nhu sway/hyprland.
switch-events {
    lid-close { spawn "systemctl" "suspend"; }
}

binds {
    Mod+Alt+Shift+L hotkey-overlay-title="Thoát phiên niri?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Exit niri session?' | grep -q Yes && niri msg action quit"; }
    Mod+Alt+Shift+R hotkey-overlay-title="Khởi động lại?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Reboot the system?' | grep -q Yes && systemctl reboot"; }
    Mod+Alt+Shift+S hotkey-overlay-title="Tắt máy?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Shutdown the system?' | grep -q Yes && systemctl poweroff"; }
    Mod+Alt+Shift+H hotkey-overlay-title="Hibernate?" { spawn-sh "echo -e 'Yes\\nNo' | rofi -dmenu -p 'Hibernate the system?' | grep -q Yes && systemctl hibernate"; }
}

// GPU: HDMI noi vao NVIDIA, smithay chon GPU chinh theo `boot_vga` (Intel)
// nen mac dinh ve tren iGPU roi copy sang — dung duong da lam Hyprland giat
// chuot. niri khong co bien moi truong cho viec nay, va nhan RENDER node chu
// khong phai card node. `/dev/dri/nvidia-render` la symlink cua udev
// (hosts/rog/nvidia.nix) — dung no, khong dung `renderD129` (so vo tinh).
//
// `debug` la bac API thap nhat, khong duoc bao ve breaking-change policy:
// niri moi len phien khong len thi xem cho nay dau tien.
debug {
    render-drm-device "/dev/dri/nvidia-render"
}
