{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "router-search": {
      "type": "local",
      "command": [
        "router-search-mcp"
      ],
      "enabled": true
    },
    "pixellab": {
      "type": "remote",
      "url": "https://api.pixellab.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:PIXELLAB_TOKEN}"
      },
      "enabled": true
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:ROUTER_ENDPOINT}",
        "apiKey": "{env:ROUTER_KEY}"
      },
      "models": {
        "combo1": {
          "name": "combo1",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "combo2": {
          "name": "combo2",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "taoxyz": {
          "name": "taoxyz",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "permission": "allow",
  "logLevel": "WARN",
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/combo1"
    }
  }
}
