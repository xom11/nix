{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "router-search": {
      "type": "local",
      "command": [
        "router-search-mcp"
      ],
      "enabled": true
    },
    "pixellab": {
      "type": "remote",
      "url": "https://api.pixellab.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:PIXELLAB_TOKEN}"
      },
      "enabled": false
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:ROUTER_ENDPOINT}",
        "apiKey": "{env:ROUTER_KEY}"
      },
      "models": {
        "combo": {
          "name": "combo",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "permission": "allow",
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "./plugin/auto-continue.mjs"
  ],
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/combo"
    }
  }
}
