#!/bin/sh
#
# Chặn secret trước khi nó thành public.
#
# Repo này public, và lịch sử git thì vĩnh viễn -- xoá ở commit sau không gỡ được
# thứ đã có ở commit trước. Push là công bố. Đây là cửa cuối cùng còn có nghĩa.
#
# Ba quyết định đáng giải thích:
#
# 1. ĐỐI CHIẾU CHÍNH XÁC với giá trị secret thật, không đoán bằng entropy/regex.
#    gitleaks đã quét toàn bộ lịch sử repo này và bỏ sót đúng key 9router, vì chữ
#    `Bearer` có dấu cách còn regex bắt giá trị của luật `generic-api-key` cần
#    chuỗi liền mạch. Máy đoán hình dạng luôn có vùng mù; so từng chữ thì không.
#
# 2. `git log -p` TỪNG COMMIT, không phải `git diff` tổng. Thêm key rồi xoá trước
#    khi push thì diff tổng sạch trơn, nhưng key vẫn nằm vĩnh viễn ở commit giữa.
#    Đó đúng là hình dạng vụ rò rỉ đã xảy ra ở repo này.
#
# 3. NGUỒN GIÁ TRỊ là hợp của plaintext trên máy VÀ bản giải mã từ ciphertext
#    trong repo. Ciphertext thì máy nào clone cũng có; plaintext chỉ có ở máy
#    chạy agenix, mà số đó là thiểu số. Nếu chỉ dựa vào plaintext thì phần lớn
#    máy phải bật một lối thoát vĩnh viễn, tức là hàng rào tắt mà không ai biết --
#    đúng cái bệnh hook này sinh ra để chữa.
#
# Bỏ qua một lần:  git push --no-verify

set -u

# Byte-wise, không phụ thuộc locale. awk của macOS bỏ cuộc với "multibyte
# conversion failure" khi gặp UTF-8 dưới locale UTF-8, mà repo này đầy comment
# tiếng Việt nên gần như mọi diff đều có. Đối chiếu chính xác vốn là việc của
# byte chứ không phải của ký tự, nên ép C là đúng chứ không chỉ là né lỗi.
#
# Đặt sau khi git đã chạy: chỉ ảnh hưởng awk và các lệnh bên dưới.
export LC_ALL=C

MARK='@@nix-prepush-secrets-end@@'

# Ngưỡng độ dài tối thiểu của một giá trị được coi là đáng đối chiếu. Là CHÍNH
# SÁCH viết thẳng trong mã, không phải số đo lấy từ secret sống.
MINLEN=12

hookdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
scanner="$hookdir/lib/scan-history.awk"

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=

CIPHER="$root/home-manager/programs/zsh/age.d/apikey.zsh.age"
AUTHORIZED="$root/home-manager/programs/ssh/authorized_keys"
IDENTITY="$HOME/.ssh/id_ed25519"

say() { printf '%s\n' "$*" >&2; }

# Thiếu bộ quét là hàng rào hỏng, không phải hàng rào sạch.
if [ ! -r "$scanner" ]; then
    say "pre-push: không đọc được $scanner -- hook hỏng, không phải repo sạch."
    exit 1
fi

refs=$(cat)
[ -n "$refs" ] || exit 0

# ---------------------------------------------------------------------------
# Gom giá trị secret. Không có gì ra đĩa: command substitution là pipe, và
# `printf` là builtin nên giá trị không lộ qua argv của một tiến trình con.
# ---------------------------------------------------------------------------

secrets=''
nsrc=0

add_file() {
    [ -f "$1" ] && [ -r "$1" ] || return 1
    secrets="$secrets
$(cat -- "$1")"
    nsrc=$((nsrc + 1))
}

# Nguồn 1 -- plaintext trên máy nix
add_file "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/apikey.zsh" || :

# Nguồn 2 -- plaintext trên Windows. Git for Windows chạy hook bằng sh của MSYS2
# nên $LOCALAPPDATA tới đây ở dạng đường dẫn Windows; cygpath đổi nó về dạng POSIX.
localappdata=''
if [ -n "${LOCALAPPDATA:-}" ] && command -v cygpath >/dev/null 2>&1; then
    localappdata=$(cygpath -u "$LOCALAPPDATA" 2>/dev/null) || localappdata=''
fi
[ -n "$localappdata" ] || localappdata="$HOME/AppData/Local"
add_file "$localappdata/pwsh-secrets/apikey.ps1" || :

# Nguồn 3 -- giải mã ciphertext trong repo. Đây là nguồn duy nhất không phụ thuộc
# vào việc agenix đã chạy hay chưa.
if [ -r "$CIPHER" ] && [ -r "$IDENTITY" ] && command -v age >/dev/null 2>&1; then
    if plain=$(age -d -i "$IDENTITY" "$CIPHER" 2>/dev/null); then
        secrets="$secrets
$plain"
        nsrc=$((nsrc + 1))
    fi
    unset plain
fi

# ---------------------------------------------------------------------------
# Không lấy được nguồn nào: máy này có ĐÁNG LẼ phải giải mã được không?
#
# `authorized_keys` là nguồn chân lý cho danh sách người nhận (agenix/keys.nix
# sinh ra từ chính nó). Máy có tên trong đó mà không lấy được gì nghĩa là hàng
# rào hỏng -- đúng lỗi airm3 từng bị: có tên trong danh sách nhưng quên
# `agenix.enable`, nên secret im lặng không nạp, không lỗi, không cảnh báo.
# ---------------------------------------------------------------------------

is_recipient() {
    [ -r "$AUTHORIZED" ] && [ -r "$IDENTITY" ] || return 1
    command -v ssh-keygen >/dev/null 2>&1 || return 1
    # </dev/null để một khoá có passphrase làm lệnh này LỖI chứ không TREO chờ nhập.
    mypub=$(ssh-keygen -y -f "$IDENTITY" 2>/dev/null </dev/null) || return 1
    material=$(printf '%s\n' "$mypub" | awk 'NR == 1 { print $2 }')
    [ -n "$material" ] || return 1
    awk -v m="$material" '$2 == m { found = 1 } END { exit(found ? 0 : 1) }' "$AUTHORIZED"
}

if [ "$nsrc" -eq 0 ]; then
    if is_recipient; then
        say ''
        say 'pre-push: CHẶN -- máy này có tên trong home-manager/programs/ssh/authorized_keys,'
        say '          nghĩa là nó ĐÁNG LẼ giải mã được secret, nhưng không lấy được giá trị nào.'
        say ''
        say '          Hàng rào đang hỏng chứ không phải repo đang sạch. Kiểm:'
        say '            - modules.home-manager.programs.agenix.enable đã bật ở host này chưa'
        say '            - lệnh `age` có trong PATH không'
        say '            - ~/.ssh/id_ed25519 có đúng là khoá đã đăng ký không'
        say ''
        say '          Đã kiểm và vẫn muốn push:  git push --no-verify'
        say ''
        exit 1
    fi
    say 'pre-push: máy này không giữ secret nào (không có tên trong authorized_keys) -- bỏ qua đối chiếu.'
    exit 0
fi

# ---------------------------------------------------------------------------
# Quét
# ---------------------------------------------------------------------------

# Ép mọi tuỳ chọn ảnh hưởng hình dạng output, để bộ quét không phụ thuộc cấu hình
# git của từng máy: `format.pretty`, `log.decorate`, `diff.external`,
# `diff.noprefix` đều đổi được output đủ để bộ quét mù.
scan_range() {
    {
        printf '%s\n' "$secrets"
        printf '%s\n' "$MARK"
        git --no-pager log -p --cc \
            --no-color --no-decorate --no-ext-diff --no-textconv \
            --pretty=medium --src-prefix=a/ --dst-prefix=b/ \
            "$@" </dev/null 2>/dev/null
    } | awk -v mark="$MARK" -v minlen="$MINLEN" -f "$scanner"
}

printf '%s\n' "$refs" | {
    rc=0
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue

        # "toàn số 0" thay vì so với 40 ký tự: đúng cho cả sha1 lẫn sha256.
        case "$local_sha" in
        *[!0]*) ;;
        *) continue ;; # đang xoá branch trên remote, không có gì để quét
        esac

        newbranch=0
        case "$remote_sha" in
        *[!0]*) ;;
        *) newbranch=1 ;;
        esac

        # Remote đã bị rebase/gc thì sha kia không còn tồn tại ở local, và
        # `A..B` sẽ lặng lẽ không ra gì. Rơi về nhánh branch-mới thay vì quét rỗng.
        if [ "$newbranch" -eq 0 ] &&
            ! git rev-parse --verify --quiet "${remote_sha}^{commit}" >/dev/null 2>&1; then
            newbranch=1
        fi

        if [ "$newbranch" -eq 1 ]; then
            set -- "$local_sha" --not --remotes
        else
            set -- "${remote_sha}..${local_sha}"
        fi

        hits=$(scan_range "$@") || {
            rc=1
            say ''
            say "pre-push: CHẶN -- tìm thấy giá trị secret thật trong ${local_ref:-?} sắp push."
            say ''
            printf '%s\n' "$hits" | while IFS="$(printf '\t')" read -r name sha where; do
                say "    $name  ->  ${sha} : ${where}"
            done
            say ''
            say '          Chỉ in TÊN biến, không in giá trị.'
            say '          Xoá ở commit sau KHÔNG đủ -- nó vẫn nằm trong lịch sử. Phải sửa'
            say '          lịch sử (rebase/amend) trước khi push, và rotate key nếu đã lỡ push.'
            say ''
        }
    done
    exit "$rc"
}
